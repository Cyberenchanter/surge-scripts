#!name=Bilibili Feed Cleanup
#!desc=Intended for desktop version of Bilibili web only. Removes ads, sponsored videos, live streaming and promo floor cards (anime/course plugs) from the homepage feed and search results. Works in two layers: a script injected into the homepage document handles cards preloaded into the HTML, and a response filter handles the recommendation and search APIs.

[Script]
# Homepage document — DOM pass. Also covers the first screen of cards, which
# bilibili server-renders into the HTML instead of fetching from the feed API.
bilibili-page-cleanup = type=http-response,pattern=^https:\/\/www\.bilibili\.com\/(?:index\.html)?(?:[?#]|$),requires-body=true,max-size=10485760,script-path=https://raw.githubusercontent.com/cyberenchanter/surge-scripts/main/js/bilibili_feed_cleanup_frontend.js
# Homepage recommendation API — every page of the feed after the first.
bilibili-feed-cleanup = type=http-response,pattern=^https:\/\/api\.bilibili\.com\/x\/web-interface\/(?:wbi\/)?index\/top\/feed\/rcmd\?,requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/cyberenchanter/surge-scripts/main/js/bilibili_feed_cleanup.js
# Search API — not reachable by the DOM pass, which only injects on the homepage.
bilibili-search-cleanup = type=http-response,pattern=^https:\/\/api\.bilibili\.com\/x\/web-interface\/(?:wbi\/)?search\/all\/v2\?,requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/cyberenchanter/surge-scripts/main/js/bilibili_feed_cleanup.js

[MITM]
hostname = %APPEND% www.bilibili.com, api.bilibili.com
