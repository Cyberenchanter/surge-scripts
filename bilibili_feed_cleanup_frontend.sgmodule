#!name=Bilibili Feed Cleanup (Frontend)
#!desc=Intended for desktop version of Bilibili web only. Removes ads, sponsored videos, live streams and promo floor cards (anime/course plugs) from the homepage feed by injecting a script into the page.

[Script]
bilibili-feed-cleanup-frontend = type=http-response,pattern=^https:\/\/www\.bilibili\.com\/(?:index\.html)?(?:[?#]|$),requires-body=true,max-size=10485760,script-path=https://raw.githubusercontent.com/cyberenchanter/surge-scripts/main/js/bilibili_feed_cleanup_frontend.js

[MITM]
hostname = %APPEND% www.bilibili.com
